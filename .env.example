# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=your_key_here

# 网易邮箱 SMTP 配置
# 发件邮箱地址
EMAIL_ADDRESS=your_email@163.com
# SMTP 授权码（不是登录密码！在网易邮箱设置 → POP3/SMTP/IMAP → 开启并获取）
EMAIL_PASSWORD=your_smtp_auth_code_here
# SMTP 服务器（163邮箱默认 smtp.163.com，126 用 smtp.126.com）
EMAIL_HOST=smtp.163.com
# SMTP 端口（SSL 默认 465）
EMAIL_PORT=465
# 收件人邮箱
EMAIL_TO=recipient@example.com
